# The same daily run on a machine you own. Install with `crontab -e`.
#
# cron starts with a minimal PATH, so uv and gh must be on the PATH you set
# here. Keys live in a .env file the command sources, never in the crontab.
# Run `gh auth login` once as this user, or put GH_TOKEN in the same .env.
#
# m h dom mon dow   command
0 6 * * 1-5  cd /srv/newsroom && PATH=/usr/local/bin:/opt/homebrew/bin:$PATH && set -a && . ./.env && set +a && uv run --locked newsroom run --contract contracts/<org> >> logs/newsroom.log 2>&1
