# Copy to .env and fill in. The runtime reads the variable named by
# provider.api_key_env in config.yml; the others are here for the usual cases.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# gh reads this on a machine with no `gh auth login`; GitHub Actions sets it for you.
GH_TOKEN=
# Overrides output.github.repo in config.yml.
NEWSROOM_GITHUB_REPO=
