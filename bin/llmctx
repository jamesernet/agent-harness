#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
usage:
  llmctx install [--account <name>]
  llmctx version [--json]
  llmctx doctor [--json|--quiet] [--account <name>]
  llmctx explain <profile|branchPolicy|irreversiblePolicy|protectedBranches> [repo]
  llmctx account list [--provider claude|codex] [--json]
  llmctx account add [--provider claude|codex] <name> <dir>
  llmctx account remove [--provider claude|codex] <name>
  llmctx skills install [--dev] [--bundle <name>[,<name>...]] [--account <name>]
  llmctx agents install [--dev] [--account <name>]
  llmctx client apply <profile.toml> [--check]
  llmctx context apply <profile.toml> [--check]
  llmctx vendor check
  llmctx repo diff [repo] [--json]
  llmctx env check [repo]
  llmctx env explain [repo]
  llmctx publish sync [--check]

`profile` is a REPOSITORY policy (personal|client). A work `context` is an
identity and security boundary. A provider `account` is a Claude or Codex home
and separate login. Different axes, deliberately different words.
EOF
}

command_name="${1:-}"
case "$command_name" in
  install)
    shift
    exec "$SCRIPT_DIR/bootstrap.sh" "$@"
    ;;
  version)
    shift
    exec "$SCRIPT_DIR/version.sh" "$@"
    ;;
  doctor)
    shift
    exec "$SCRIPT_DIR/doctor.sh" "$@"
    ;;
  explain)
    shift
    exec "$SCRIPT_DIR/explain-policy.sh" "$@"
    ;;
  account)
    shift
    exec "$SCRIPT_DIR/account.sh" "$@"
    ;;
  skills)
    [[ "${2:-}" == "install" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/install-skills.sh" "$@"
    ;;
  agents)
    [[ "${2:-}" == "install" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/install-agents.sh" "$@"
    ;;
  client)
    [[ "${2:-}" == "apply" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/client-apply.sh" "$@"
    ;;
  context)
    [[ "${2:-}" == "apply" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/client-apply.sh" "$@"
    ;;
  vendor)
    [[ "${2:-}" == "check" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    [[ "$#" -eq 0 ]] || {
      usage >&2
      exit 2
    }
    exec "$SCRIPT_DIR/check-vendor-lock.sh" "$@"
    ;;
  env)
    case "${2:-}" in
      check | explain) ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    sub="$2"
    shift 2
    exec "$SCRIPT_DIR/env-check.sh" "$sub" "$@"
    ;;
  repo)
    [[ "${2:-}" == "diff" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/repo-diff.sh" "$@"
    ;;
  publish)
    [[ "${2:-}" == "sync" ]] || {
      usage >&2
      exit 2
    }
    shift 2
    exec "$SCRIPT_DIR/sync-published-context.sh" "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
