{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/branch-gate.sh",
            "statusMessage": "Checking branch policy..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/account-gate.sh",
            "statusMessage": "Checking the Claude account for this path..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/irreversible-gate.sh",
            "statusMessage": "Checking for an action that cannot be undone..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/account-notice.sh",
            "statusMessage": "Checking the Claude account for this directory..."
          },
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/environment-notice.sh",
            "statusMessage": "Checking the AWS environment for this context..."
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30
}
