{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/branch-policy.sh",
            "statusMessage": "Checking branch policy..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/account-guard.sh",
            "statusMessage": "Checking the Claude account for this path..."
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30
}
